; Atomic Bomberman on the DualSense, as the first keyboard player: the d-pad
; moves, Cross drops a bomb (Space) and Circle is the action key (Enter: stop
; a kicked bomb, punch, set off trigger bombs). Enter also confirms in the
; menus; Options is Escape, to go back. The left stick
; moves the pointer and R2/L2 click, for the screens that need the mouse
; (the keyboard definitions).
[input]
mode = keyboard
mouse = left_stick
mouse_speed = 900
r2 = mouse_left
l2 = mouse_right
up = up
down = down
left = left
right = right
cross = space
circle = enter
square = space
triangle = enter
options = escape
create = escape
